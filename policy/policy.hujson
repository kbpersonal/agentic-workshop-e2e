{
	"tagOwners": {
		"tag:server":          ["autogroup:admin"],
		"tag:border0-managed": ["autogroup:admin"],
		"tag:infra":           ["autogroup:admin"],
		"tag:k8s-operator":    ["tag:infra", "autogroup:admin"],
		"tag:k8s":             ["tag:k8s-operator"],
		"tag:subnet-router":   ["tag:infra"],
		"tag:ci-deployer":     ["autogroup:admin"],
		"tag:k8s-dev":         ["tag:k8s-operator"],
		"tag:aperture":        ["autogroup:admin"],
	},

	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:admin"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:admin"],
			"dst": [
				"tag:server",
				"tag:infra",
				"tag:k8s-operator",
				"tag:k8s",
				"tag:subnet-router",
			],
			"ip": ["*"],
		},
		{
			"src": ["*"],
			"dst": ["tag:border0-managed"],
			"ip":  ["*"],

			"app": {
				"tailscale.com/cap/pam": [
					{
						"version": "v1",

						"permissions": {
							"http": {},

							"ssh": {
								"shell": {},
								"exec":  {},
								"sftp":  {},
							},

							"database": {},
						},
					},
				],
			},
		},
		{
			"src": ["autogroup:admin"],
			"dst": ["svc:workshop-app", "tag:k8s-dev"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["autogroup:admin", "tag:ci-deployer"],
			"dst": ["svc:gke-dev"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/pam": [{
					"version": "v1",
					"permissions": {
						"kubernetes": {
							"rules": [{
								"api_groups":     ["*"],
								"namespaces":     ["dev"],
								"resources":      ["*"],
								"resource_names": ["*"],
								"verbs":          ["*"],
							}],
						},
					},
				}],
			},
		},
		{
			"src": ["autogroup:admin"],
			"dst": ["tag:aperture"],
			"ip":  ["tcp:80"],
			"app": {
				"tailscale.com/cap/aperture": [
					{"role": "user"},
					{"models": "**"},
				],
			},
		},
	],

	"nodeAttrs": [
		{
			"target": ["*"],

			"app": {
				"tailscale.com/app-connectors": [
					{
						"name":       "tun-repro",
						"connectors": ["tag:server"],
						"domains":    ["ifconfig.me"],
					},
				],
			},
		},
	],

	"autoApprovers": {
		"routes": {
			"0.0.0.0/0":      ["tag:server", "tag:infra"],
			"::/0":           ["tag:server", "tag:infra"],
			"10.0.0.0/8":     ["tag:infra", "tag:k8s", "tag:subnet-router"],
			"172.16.0.0/12":  ["tag:infra", "tag:k8s", "tag:subnet-router"],
			"192.168.0.0/16": ["tag:infra", "tag:k8s", "tag:subnet-router"],
		},
		"services": {
			"tag:k8s-dev":         ["tag:k8s-dev"],
			"tag:border0-managed": ["tag:border0-managed"],
		},
	},

	"ssh": [
		{
			"action": "accept",
			"src":    ["tag:server"],
			"dst":    ["tag:server"],
			"users":  ["root"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["tag:server"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
		{
			"src":  "tag:ci-deployer",
			"deny": ["svc:workshop-app:443"],
		},
	],
}
